{
  "name": "@zls/letzebuergesch-mcp",
  "version": "0.2.0",
  "description": "MCP server for Luxembourgish: LOD dictionary, spellchecker (incl. n-rule hints) and the ZLS multilingual translation corpus.",
  "type": "module",
  "license": "EUPL-1.2",
  "bin": {
    "zls-mcp": "dist/stdio.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "test": "vitest run",
    "smoke": "node dist/scripts/smoke.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/stdio.js",
    "start:render": "HOST=0.0.0.0 node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dictionary-lb": "^4.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "nspell": "^2.1.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/nspell": "^2.1.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}